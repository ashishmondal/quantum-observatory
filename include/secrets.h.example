// Wi-Fi + MQTT credentials template. Copy to secrets.h and fill in.
// secrets.h is gitignored; this .example is the committed reference.
//
// (added in phase 5.1, MQTT fields added in phase 5.2)

#pragma once

#define WIFI_SSID      "your-ssid-here"
#define WIFI_PASSWORD  "your-password-here"

// MQTT broker the device connects to (Phase 5.2). Username/password are
// optional — leave as empty strings for an anonymous broker.
#define MQTT_HOST       "192.168.1.10"
#define MQTT_PORT       1883
#define MQTT_CLIENT_ID  "quantum-observatory"
#define MQTT_USERNAME   ""
#define MQTT_PASSWORD   ""
