# Quantum Observatory — local secrets for homeassistant/setup_mqtt.py.
#
# Copy this file to `.env` (in the repo root, in homeassistant/, or in
# whatever directory you run setup_mqtt.py from), fill in the real
# values, and `chmod 600 .env`. The file is gitignored.
#
# Loader rules (see setup_mqtt.py docstring for the full description):
#   * First match wins, in order: $CWD/.env, homeassistant/.env, repo-root .env.
#   * Real environment variables always beat the file (so a one-off
#     `HA_TOKEN=... python ...` still works).
#   * Format is `KEY=value` per line. `#` comments + blank lines + an
#     optional leading `export` are tolerated. Quotes are stripped.

# --- required for every run ---------------------------------------
HA_URL=http://homeassistant.local:8123
# Long-Lived Access Token from {HA_URL}/profile/security
HA_TOKEN=eyJ...

# --- only needed for --install / --install-publisher / --all -----
# Defaults: HA_SSH_HOST = host portion of HA_URL, HA_SSH_USER = root,
# HA_SSH_PORT = 22 (official Terminal & SSH add-on; use 22222 for
# the community "Advanced SSH & Web Terminal" add-on).
#HA_SSH_HOST=homeassistant.local
#HA_SSH_USER=root
#HA_SSH_PORT=22
#HA_SSH_KEY=~/.ssh/id_ed25519
